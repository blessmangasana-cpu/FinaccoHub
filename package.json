{
  "name": "rse-data-pipeline",
  "version": "1.0.0",
  "description": "Automated Rwanda Stock Exchange daily equities pipeline",
  "type": "module",
  "main": "src/jobs/dailyJob.js",
  "scripts": {
    "start": "node src/jobs/dailyJob.js",
    "scrape": "node src/scraper/scrapeRSE.js",
    "scrape:history": "node scripts/scrapeHistory.js --weeks=7",
    "scrape:range": "node scripts/scrapeHistoricalRange.js --start=2026-01-01 --end=2026-05-15",
    "lint": "node scripts/checkSyntax.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand --no-coverage",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "db:seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^5.22.0",
    "axios": "^1.6.0",
    "cheerio": "^1.0.0-rc.12",
    "dotenv": "^16.3.1",
    "pg": "^8.20.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "prisma": "^5.22.0"
  }
}

# Database Configuration
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"

# Environment
NODE_ENV=development

# Logging
LOG_LEVEL=info

# Application
PORT=3000
APP_NAME=rse-data-pipeline

# Features
ENABLE_SCHEDULER=true
SCHEDULER_TIME="17:15" # Africa/Kigali time

# Scraper
RSE_SCRAPE_URL="https://www.rse.rw/market-data/equities"

# Database Configuration
# For local development (PostgreSQL)
DATABASE_URL="postgresql://postgres:3457@localhost:5432/RSE"

# For Supabase (Production - GitHub Actions)
# DATABASE_URL="postgresql://postgres.xxxxx:[PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres.xxxxx:[PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"

# Environment
NODE_ENV=development

# Logging
LOG_LEVEL=info

# Application
PORT=3000
APP_NAME=rse-data-pipeline

# Features
ENABLE_SCHEDULER=true
SCHEDULER_TIME="17:15" # Africa/Kigali time

# Scraper
RSE_SCRAPE_URL="https://www.rse.rw/market-data/equities"

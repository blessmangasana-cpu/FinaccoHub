# ===========================================
# DATABASE CONFIGURATION
# ===========================================

# Local Development (PostgreSQL via Docker)
DATABASE_URL="postgresql://postgres:3457@localhost:5432/RSE"
DIRECT_URL="postgresql://postgres:3457@localhost:5432/RSE"

# Production (Supabase) - For GitHub Actions/Render
# Uncomment these and comment out local URLs when deploying
# DATABASE_URL="postgresql://postgres.xxxxx:[YOUR_PASSWORD]@aws-1-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres.xxxxx:[YOUR_PASSWORD]@aws-1-eu-central-1.pooler.supabase.com:5432/postgres"

# ===========================================
# APPLICATION CONFIGURATION
# ===========================================

# Environment
NODE_ENV=development

# Logging
LOG_LEVEL=info

# Application
PORT=3000
APP_NAME=rse-data-pipeline

# Features
ENABLE_SCHEDULER=false
SCHEDULER_TIME="17:15"

# Scraper
RSE_SCRAPE_URL="https://www.rse.rw/"

# Backup
BACKUP_RAW_JSON=true

# ===========================================
# DOCKER POSTGRESQL (for local development)
# ===========================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=3457
POSTGRES_DB=RSE
POSTGRES_PORT=5432
